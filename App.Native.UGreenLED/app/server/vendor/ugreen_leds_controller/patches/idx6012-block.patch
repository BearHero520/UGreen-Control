+/* Wire facts from official leds-mcu.ko probe 0x16e9..0x17d6.
+ * This explicit operation is never run by open, status, or ordinary writes. */
+int ugreenctl_led_initialize_idx6012(struct ugreenctl_led_session *session,
+                                    char *error, size_t error_size)
+{
+    static const uint8_t commands[5][5] = {
+        {4,0,0,0,0}, {1,255,0,0,0}, {2,255,255,255,0},
+        {3,255,0,0,0}, {1,255,0,0,0}
+    };
+    struct ugreenctl_led_value value, saved_power;
+    struct ugreenctl_led_patch restore = {0};
+    uint8_t frame[UGREENCTL_LED_COMMAND_SIZE];
+    int result;
+    if (!session || !session->identity.profile ||
+        (strcmp(session->identity.profile->id,"idx6012-block") &&
+         strcmp(session->identity.profile->id,"idx6012-v3-block")))
+        return fail(error,error_size,-ENOTSUP,"initialization requires an exact iDX6012 profile");
+    result=authorize_write(session,error,error_size);
+    if (result<0) return result;
+    /* Refuse before mutation if any modeled LED cannot be read. */
+    for (unsigned int id=0;id<8;++id) {
+        result=ugreenctl_led_read(session,(uint8_t)id,&value,error,error_size);
+        if (result<0) return result;
+        if (id==0) saved_power=value;
+    }
+    for (unsigned int step=0;step<5;++step) {
+        result=authorize_write(session,error,error_size);
+        if (result<0) return result;
+        result=ugreenctl_led_encode_smbus(commands[step][0],commands[step]+1,false,frame);
+        if (result<0) return result;
+        result=session->io.write_command(session->opaque,0,frame);
+        if (result<0) return fail(error,error_size,result,"initialization write failed at step %u; LED state may have changed",step+1);
+        session->io.pause_ms(session->opaque,2);
+        result=session->io.read_ack(session->opaque);
+        if (result<0) return fail(error,error_size,result,"initialization ACK failed at step %u; LED state may have changed",step+1);
+        session->io.pause_ms(session->opaque,50);
+    }
+    result=ugreenctl_led_read(session,0,&value,error,error_size);
+    if (result<0) return result;
+    if (value.mode!=UGREENCTL_LED_MODE_ON || value.brightness!=255 ||
+        value.red!=255 || value.green!=255 || value.blue!=255)
+        return fail(error,error_size,-EIO,"initialization power state did not match; autonomous animation may remain active");
+    /* Preserve the power indicator even when the application does not manage
+     * it. Restore mode first because some MCU modes reset the RGB fields. */
+    restore.value=saved_power;
+    restore.fields=UGREENCTL_LED_PATCH_MODE;
+    if (saved_power.mode==UGREENCTL_LED_MODE_BLINK || saved_power.mode==UGREENCTL_LED_MODE_BREATH)
+        restore.fields|=UGREENCTL_LED_PATCH_TIMING;
+    result=ugreenctl_led_apply(session,0,&restore,&value,error,error_size);
+    if (result<0) return result;
+    restore.fields=UGREENCTL_LED_PATCH_RGB | UGREENCTL_LED_PATCH_BRIGHTNESS;
+    return ugreenctl_led_apply(session,0,&restore,&value,error,error_size);
+}
