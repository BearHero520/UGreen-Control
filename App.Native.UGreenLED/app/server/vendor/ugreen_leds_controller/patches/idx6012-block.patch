+/* A placeholder product name is accepted only for the recorded UGREEN board.
+ * This LED-only resolver never changes the BIOS/fan machine identity. */
+static const struct ugreenctl_led_profile *led_profile_for_identity(
+    const struct ugreenctl_led_identity *identity, const char *model)
+{
+    const struct ugreenctl_led_profile *profile =
