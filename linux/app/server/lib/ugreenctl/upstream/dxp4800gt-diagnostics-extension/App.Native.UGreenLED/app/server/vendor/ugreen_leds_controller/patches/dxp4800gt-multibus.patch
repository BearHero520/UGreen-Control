+static int gt_open_candidate(struct ugreenctl_led_session *session, unsigned int bus)
+{
+    struct stat st;
+    unsigned long functions = 0;
+    int result;
+    session->bus_number = bus;
+    (void)snprintf(session->bus, sizeof(session->bus), "/dev/i2c-%u", bus);
+    result = verify_session_identity(session, NULL, 0);
+    if (!result) result = session->io.owners(session->opaque);
+    if (result < 0) return result;
+    session->fd = open(session->bus, O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+    if (session->fd < 0) return -errno;
+    if (fstat(session->fd, &st) < 0) return -errno;
+    if (!S_ISCHR(st.st_mode) || major(st.st_rdev) != 89 || minor(st.st_rdev) != bus)
+        return -ENODEV;
+    if (ioctl(session->fd, I2C_FUNCS, &functions) < 0) return -errno;
+    if (!(functions & I2C_FUNC_SMBUS_READ_WORD_DATA)) return -EOPNOTSUPP;
+    if (ioctl(session->fd, I2C_SLAVE, 0x3a) < 0) return -errno;
+    return 0;
+}
+
+static int gt_probe_candidate(void *opaque, unsigned int bus)
+{
+    struct ugreenctl_led_session *session = opaque;
+    uint16_t chip = 0;
+    int result = gt_open_candidate(session, bus);
+    if (!result) {
+        result = session->io.read_chip_id(session->opaque, &chip);
+        /* Only a target NACK or a returned nonmatching ID means absent.
+         * Timeouts, permission errors and busy ownership remain fatal. */
+        if (result == -ENXIO || result == -EREMOTEIO) result = 0;
+        else if (!result) result = chip == 0xc5b2 ? 1 : 0;
+    }
+    if (session->fd >= 0) { close(session->fd); session->fd = -1; }
+    return result;
+}
