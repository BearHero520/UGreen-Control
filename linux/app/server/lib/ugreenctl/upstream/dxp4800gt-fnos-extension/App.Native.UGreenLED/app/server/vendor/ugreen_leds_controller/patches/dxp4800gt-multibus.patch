+++ b/led/led_gt_bus.h
@@ -0,0 +1,37 @@
+/* DXP4800 GT: stock leds-mcu 1.21.1.0016 reads 0x3a:0x5a
+ * across SMBus/Synopsys adapters and expects 0xc5b2. No data writes.
+ * This application-owned CLI extension deliberately rejects ambiguity. */
+#ifndef LED_GT_BUS_H
+#define LED_GT_BUS_H
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+
+enum gt_bus_family { GT_BUS_OTHER = -1, GT_BUS_DESIGNWARE, GT_BUS_PIIX4 };
+
+static enum gt_bus_family gt_bus_family(const char *name)
+{
+    if (!strcmp(name, "Synopsys DesignWare I2C adapter")) return GT_BUS_DESIGNWARE;
+    if (!strncmp(name, "SMBus PIIX4 adapter ", 20)) return GT_BUS_PIIX4;
+    return GT_BUS_OTHER;
+}
+
+/* Both probe and selection return 1 for verified, 0 for no matching ID,
+ * negative for a hard failure. Keep no-match distinct from -ENODEV caused by
+ * an invalid character device; only the former permits another family. */
+static int gt_select_bus(const unsigned int *buses, size_t count,
+                         int (*probe_bus)(void *, unsigned int), void *opaque,
+                         unsigned int *selected)
+{
+    unsigned int matches = 0, winner = 0;
+    for (size_t i = 0; i < count; ++i) {
+        int result = probe_bus(opaque, buses[i]);
+        if (result < 0) return result;
+        if (result > 0) { ++matches; winner = buses[i]; }
+    }
+    if (!matches) return 0;
+    if (matches != 1) return -ENOTUNIQ;
+    *selected = winner;
+    return 1;
+}
+#endif
